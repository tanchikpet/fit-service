# COPY LOCALLY ONLY. NEVER COMMIT .env WITH ACTUAL VALUES.
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/fit_requests
KAITEN_BASE_URL=https://rossko.kaiten.ru
KAITEN_SPACE_ID=332384
KAITEN_API_TOKEN=put-real-key-in-secure-host-settings
ADMIN_API_TOKEN=generate-independent-random-string-at-least-32-characters
KAITEN_WEBHOOK_SECRET=generate-another-independent-random-string-at-least-32-characters
SYNC_INTERVAL_MINUTES=15

# Telegram Login (create a dedicated bot in @BotFather and register PUBLIC_ORIGIN and its /auth/callback URL)
PUBLIC_ORIGIN=https://your-railway-app.up.railway.app
TELEGRAM_CLIENT_ID=telegram-client-id-from-botfather
TELEGRAM_CLIENT_SECRET=set-only-in-hosting-secrets
TELEGRAM_ADMIN_ID=your-numeric-telegram-user-id

# Telegram Bot API confirmation login (no OAuth page in browser)
TELEGRAM_BOT_TOKEN=set-in-Railway-variables-only
TELEGRAM_BOT_USERNAME=fit_requests_auth_bot

# Inbound Telegram webhook secret (independent of the bot API token)
TELEGRAM_WEBHOOK_SECRET=generate-random-32-plus-characters-in-Railway
